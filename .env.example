# Docker: address of the existing CLIProxyAPI v8 server as seen by this container.
# For native npm start, use http://127.0.0.1:8317 instead.
CLIPROXY_BASE_URL=http://host.docker.internal:8317
# Exact browser-facing origin. Configure HTTPS for non-loopback access.
PUBLIC_ORIGIN=http://localhost:8080
DASHBOARD_BIND_HOST=127.0.0.1
DASHBOARD_PORT=8080
# Explicit opt-in after reviewing account-reset behavior. Read-only by default.
ENABLE_RESETS=false
# Absolute login lifetime, 1–720 hours. Set 168 for seven days; restarts still sign out.
SESSION_TTL_HOURS=8
# Leave false in normal use. This override permits cleartext remote HTTP for tests.
ALLOW_INSECURE_HTTP=false
